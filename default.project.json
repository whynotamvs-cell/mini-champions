{
  "name": "MiniChampions",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "DevPackages": {
        "$path": {
          "optional": "DevPackages"
        }
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "ServerStorage": {
      "Tests": {
        "$path": "tests/specs"
      },
      "ClubUpgrades": {
        "$path": "world/ClubUpgrades.model.json"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "LocalizationService": {
      "$path": "src/localization"
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": true
      }
    },
    "Workspace": {
      "DeskWorld": {
        "$path": "world/DeskWorld.model.json"
      }
    },
    "TextChatService": {
      "$properties": {
        "CreateDefaultTextChannels": false,
        "CreateDefaultCommands": false
      }
    }
  }
}
